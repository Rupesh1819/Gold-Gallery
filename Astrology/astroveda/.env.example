# AstroVeda Environment Variables
# Copy this file to .env.local for local development, or add these in your hosting dashboard (Vercel / Netlify / Cloudflare / Docker).

# 1. Base Public Site URL (e.g. https://yourdomain.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Remote Supabase Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# 3. Master Admin Sanctum Credentials
ADMIN_EMAIL=admin@astroveda.com
ADMIN_PASSWORD=AstroVeda@2025

# 4. Anti-Bot Verification (Cloudflare Turnstile - Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 5. Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=
