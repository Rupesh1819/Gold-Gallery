# ==============================================================================
# ASTROVEDA / MYGURUJI - COMPREHENSIVE PRODUCTION .GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging
*.env
!.env.example

# Private Credentials & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa*
*.id_rsa
service-account*.json
google-services*.json
firebase-adminsdk*.json
*credentials*.json

# Admin accounts with sensitive hashes/passwords
src/config/adminAccounts.json
!src/config/adminAccounts.example.json

# ------------------------------------------------------------------------------
# 2. SENSITIVE DOCUMENTS, AUDITS & BUSINESS DATA (PREVENT LEAKS)
# ------------------------------------------------------------------------------
# Security audit reports & pentest documents
AUDIT.md
*audit*
*pentest*
security-audit*
Pre-Launch*

# Office documents, spreadsheets, client lists & PDFs
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.csv
*.tsv
*.ppt
*.pptx

# Database dumps, raw records & backups
*.dump
*.db
*.sqlite
*.sqlite3
*.bak
*.backup
# Ignore loose SQL dumps but preserve migration scripts
*.sql
!supabase/migrations/*.sql

# ------------------------------------------------------------------------------
# 3. SCRATCH, TEMPORARY & CACHE DIRECTORIES
# ------------------------------------------------------------------------------
scratch/
temp/
tmp/
*.tmp
*.bak
*.swp
*.swo
*~

# User uploads & runtime generated media
uploads/
user_uploads/
.user_uploaded/

# ------------------------------------------------------------------------------
# 4. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 5. NEXT.JS & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
/.next/
/out/
/build/
/dist/
/.turbo/
.vercel/

# TypeScript & Test Coverage
*.tsbuildinfo
next-env.d.ts
/coverage/

# ------------------------------------------------------------------------------
# 6. LOGS & DEBUG FILES
# ------------------------------------------------------------------------------
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 7. OS & IDE CONFIGURATIONS
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE / Editor folders
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
